# Where this server is reachable from the internet (Twilio needs it). No trailing slash.
PUBLIC_URL=https://secondline.example.com
PORT=3000

# Twilio — leave blank to run without a phone line (texts are logged to the console instead).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default "from" number for texts not tied to a shop (admin alerts, login links).
TWILIO_FROM=
# Optional: numbers you've already bought, handed out to new shops first (comma separated).
TWILIO_NUMBER_POOL=
# Voice callers hear.
TWILIO_VOICE=Polly.Joanna-Neural

# Optional: the public demo line on the landing page. Callers get the owner's summary texted to them.
DEMO_NUMBER=
DEMO_TZ=America/New_York

# Optional: Gemini (free tier) tidies the job note in summaries. Works fine without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operator view at /admin?key=...  and texts to you for new pilots / cancellations / "keep it".
ADMIN_KEY=
ADMIN_PHONE=

DATA_FILE=./data/db.json
