# Where this server is reachable from the internet (Twilio needs it). No trailing slash.
PUBLIC_URL=https://secondline.example.com
PORT=3000

# Twilio — leave blank to run without a phone line (texts are logged to the console instead).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default "from" number for texts not tied to a shop (admin alerts, login links).
TWILIO_FROM=
# Optional: numbers you've already bought, handed out to new shops first (comma separated).
TWILIO_NUMBER_POOL=
# Voice callers hear.
TWILIO_VOICE=Polly.Joanna-Neural

# Optional: the public demo line on the landing page. Callers get the owner's summary texted to them.
DEMO_NUMBER=
DEMO_TZ=America/New_York

# Optional: Gemini (free tier) tidies the job note in summaries. Works fine without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operator view at /admin?key=...  and texts to you for new pilots / cancellations / "keep it".
ADMIN_KEY=
ADMIN_PHONE=

DATA_FILE=./data/db.json

# ---------- Natural voice: VoiceStudio (github.com/debpalash/VoiceStudio, free, self-hosted) ----------
# Run it as its own service (see README). Leave blank to use the standard Twilio voice.
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_MODEL=omnivoice
# A voice profile name/ID you created in VoiceStudio, or "default".
VOICESTUDIO_VOICE=default
VOICESTUDIO_SPEED=1.0
VOICESTUDIO_FORMAT=mp3
# How long a live call waits for a new sentence before using the standard voice.
VOICESTUDIO_TIMEOUT_MS=2500

# ---------- Outreach ----------
# Find shops on Google Maps (Places API, New). Reviews are billed at Google's higher rate.
GOOGLE_PLACES_API_KEY=
# Sending email: resend.com API key (free tier 100/day). Blank = practice mode (saved to data/outreach-outbox).
RESEND_API_KEY=
# Required before anything sends (CAN-SPAM): who you are and a real postal address.
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
OUTREACH_COMPANY=SecondLine
OUTREACH_ADDRESS=
OUTREACH_PHONE=
# 1 = the server sends due emails by itself (one a minute, weekdays 8am–5pm, up to the daily cap).
OUTREACH_AUTO=0
OUTREACH_DAILY_CAP=25
OUTREACH_TZ=America/New_York
# 1 = never actually send, even with a Resend key.
OUTREACH_DRY_RUN=0
# The offer (see src/outreach/offer.js). Set OFFER_SETUP_WAIVED=0 or OFFER_GUARANTEE=0 to turn those off.
OFFER_SETUP_WAIVED=1
OFFER_SPOTS=10
OFFER_DEADLINE_DAYS=14
OFFER_GUARANTEE=If it doesn't catch you a job in your first 30 days, your second month is free.
