# Rally Club environment variables. Copy to .env.local (never commit real values).
# P1 (current) needs none of these — the browser harness and core tests run fully offline.

# --- P2: phone controller relay (server/) ---
RALLY_RELAY_PORT=8787
# Public URL phones use to reach the relay (shown in the pairing QR code). Must be HTTPS/WSS for motion sensors on iOS.
RALLY_PUBLIC_URL=https://localhost:5173

# --- P5: accounts & persistence (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- P5: WebRTC video/voice ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- P5: Pixel Streaming 2 signalling (Unreal) ---
PIXEL_STREAMING_SIGNALLING_URL=ws://localhost:8888
